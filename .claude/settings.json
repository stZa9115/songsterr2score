{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(lilypond *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh repo view*)",
      "PowerShell(uv *)",
      "PowerShell(lilypond *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git fetch*)",
      "PowerShell(git pull*)",
      "PowerShell(git push*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr status*)",
      "PowerShell(gh repo view*)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push*--no-verify*)",
      "Bash(git commit*--no-verify*)",
      "Bash(gh pr merge*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push*--no-verify*)",
      "PowerShell(git commit*--no-verify*)",
      "PowerShell(gh pr merge*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-tests.sh\"",
            "shell": "bash",
            "timeout": 180,
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}
